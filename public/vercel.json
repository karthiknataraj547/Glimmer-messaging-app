{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-nexa-engine",
          "value": "nexa-sovereign-v1"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/[...all]"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/[...all]"
    },
    {
      "source": "/((?!admin|api|health|v1|assets|canvaskit|icons|favicon\\.png|flutter\\.js|flutter_bootstrap\\.js|flutter_service_worker\\.js|main\\.dart\\.js|manifest\\.json|version\\.json|nexa-release\\.apk).*)",
      "destination": "/index.html"
    }
  ]
}
