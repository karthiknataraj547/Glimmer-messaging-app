{
  "version": 2,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/health",
      "destination": "https://karl-apparel-seeks-blind.trycloudflare.com/health"
    },
    {
      "source": "/v1/:path*",
      "destination": "https://karl-apparel-seeks-blind.trycloudflare.com/v1/:path*"
    },
    {
      "source": "/((?!admin|assets|canvaskit|icons|favicon\\.png|flutter\\.js|flutter_bootstrap\\.js|flutter_service_worker\\.js|main\\.dart\\.js|manifest\\.json|version\\.json).*)",
      "destination": "/index.html"
    }
  ]
}
