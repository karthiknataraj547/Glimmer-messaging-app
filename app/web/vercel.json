{
  "rewrites": [
    {
      "source": "/admin/admin-ui.css",
      "destination": "/admin-ui.css"
    },
    {
      "source": "/admin/admin-enhancements.js",
      "destination": "/admin-enhancements.js"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/((?!admin|api|health|v1|assets|canvaskit|icons|favicon\\.png|flutter\\.js|flutter_bootstrap\\.js|flutter_service_worker\\.js|main\\.dart\\.js|manifest\\.json|version\\.json|nexa-release\\.apk).*)",
      "destination": "/index.html"
    }
  ]
}
