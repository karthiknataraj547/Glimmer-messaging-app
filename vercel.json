{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/admin",
      "dest": "public/admin/index.html"
    },
    {
      "src": "/admin/(.*)",
      "dest": "public/admin/index.html"
    },
    {
      "src": "/health",
      "dest": "backend/server.js"
    },
    {
      "src": "/v1/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}
