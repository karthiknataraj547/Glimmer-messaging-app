{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/admin/admin-ui\\.css",
      "dest": "public/admin/admin-ui.css"
    },
    {
      "src": "/admin/admin-enhancements\\.js",
      "dest": "public/admin/admin-enhancements.js"
    },
    {
      "src": "/admin",
      "dest": "public/admin/index.html"
    },
    {
      "src": "/admin/(.*)",
      "dest": "public/admin/index.html"
    },
    {
      "src": "/health",
      "dest": "api/index.js"
    },
    {
      "src": "/v1/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}
